{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/wonder-ai",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wonderxperience.com"
        }
      ],
      "destination": "https://www.wonderxperience.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/wonder-academy",
      "destination": "/academy",
      "statusCode": 301
    },
    {
      "source": "/notre-equipe",
      "destination": "/a-propos",
      "statusCode": 301
    },
    {
      "source": "/recrutement",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/demarche",
      "destination": "/a-propos",
      "statusCode": 301
    },
    {
      "source": "/rendez-vous",
      "destination": "https://wonderxperience.fillout.com/rencontre-stephane-lambin",
      "statusCode": 302
    },
    {
      "source": "/systeme",
      "destination": "/#systeme",
      "statusCode": 301
    },
    {
      "source": "/systeme-wonder",
      "destination": "/#systeme",
      "statusCode": 301
    },
    {
      "source": "/contact_1",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/index_6",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wonder-ai_2",
      "destination": "/wonder-ai",
      "statusCode": 301
    }
  ]
}